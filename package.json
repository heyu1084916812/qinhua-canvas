{
  "name": "qinghua",
  "private": true,
  "version": "0.1.8",
  "type": "module",
  "scripts": {
    "dev": "node scripts/dev-shared.mjs",
    "dev:vite": "vite",
    "storage": "cargo run --manifest-path shared-store/Cargo.toml",
    "build": "tsc --noEmit && vite build",
    "prepare:ffmpeg": "node scripts/prepare-ffmpeg.mjs",
    "preview": "vite preview",
    "check": "tsc --noEmit && eslint . && depcruise src --config .dependency-cruiser.cjs && node scripts/check-theme.mjs && node scripts/check-contrast.mjs && node scripts/check-shell-geometry.mjs && node scripts/check-rail-buttons.mjs && node scripts/check-doc-index.mjs && node scripts/check-doc-migration.mjs && node scripts/check-libtv-catalog.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "smoke": "node scripts/smoke.mjs",
    "smoke:matrix": "node scripts/smoke-matrix.mjs",
    "soak": "node scripts/soak-ui.mjs",
    "tauri": "tauri"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.12.1",
    "@tauri-apps/plugin-dialog": "^2.8.1",
    "@tauri-apps/plugin-fs": "^2.6.0",
    "@tauri-apps/plugin-notification": "^2.5.1",
    "@tauri-apps/plugin-opener": "^2.7.0",
    "@xyflow/react": "^12.12.0",
    "dexie": "^4.4.5",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^7.18.3",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.12.1",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^6.1.1",
    "dependency-cruiser": "^18.2.0",
    "eslint": "^9.39.4",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-import": "^2.32.0",
    "globals": "^17.12.0",
    "playwright": "^1.63.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.70.0",
    "vite": "^8.2.2",
    "vitest": "^5.0.0"
  }
}
