import { useCallback, useEffect, useRef, useState } from 'react'
import type { PointerEvent as ReactPointerEvent } from 'react'
import type { CompareData } from '../../../../domain/canvas/model/node'
import type { NodeViewProps } from '../registry'
import { useAssetThumbUrl } from '../../hooks/useAsset'
import { assetBoxCorrection } from '../../../../domain/canvas/layout/assetBoxCorrection'
import styles from './CompareNodeView.module.css'

/**
 * 瀵规瘮鑺傜偣瑙嗗浘锛堜骇鍝佹枃妗?搂6.10锛夈€? * 鍙栦笂娓稿墠 2 寮犲浘鐗囧乏鍙冲彔鏀撅紝涓棿绔栧悜鍒嗗壊绾垮彲鎷栧姩锛?px + 鍦嗗舰鎵嬫焺锛夛紱
 * 鎷栧姩鍙敼鏈湴鐬椂鍊硷紝鏉炬墜鎵?emit updateData锛堥伩鍏嶆嫋鍔ㄦ湡鍒峰懡浠?/ 杩涙挙閿€鏍堬級銆? * 涓婃父涓嶈冻 2 寮犳椂缂轰綅鏄剧ず绌虹姸鎬佸崰浣嶃€? */
export function CompareNodeView(props: NodeViewProps) {
  const data = props.node.data as CompareData
  const hashes = props.upstreamAssetHashes ?? []
  const leftFallback = hashes[0] ?? data.leftAssetHash
  const rightFallback = hashes[1] ?? data.rightAssetHash
  // 瀵规瘮鍖烘槸**鑺傜偣灏哄**鐨勫皬鍥?鈬?璧扮缉鐣ュ浘閭ｆ潯璺紙瀵硅处 #231锛夛細鎷?4K 鍘熷浘瑙ｇ爜缁欒繖涔堝皬鐨勬鐪嬩笉鍒掔畻
  const leftUrl = useAssetThumbUrl(leftFallback)
  const rightUrl = useAssetThumbUrl(rightFallback)

  const [ratio, setRatio] = useState(data.splitRatio)
  const [dragging, setDragging] = useState(false)
  // 鏉炬墜鍚庡緟澶栭儴纭鐨勫€硷細emit 璧板懡浠ゅ眰 鈫?store 鈫?props 鍥炵亴鏈夊欢杩燂紝
  // 鍥炵亴鍒颁綅鍓嶄繚鐣欐湰鍦板€硷紝閬垮厤瑙嗚鍥炲脊锛堥檲鍒楀 emit 涓虹┖瀹炵幇鏃朵篃淇濇寔绋冲畾锛夈€?  const pendingRef = useRef<number | null>(null)

  // 璺熼殢澶栭儴鏁版嵁锛氫粎鍦ㄣ€屾病鏈夊緟纭鍊笺€嶆垨銆屽閮ㄥ凡杩藉钩寰呯‘璁ゅ€笺€嶆椂鍚屾
  useEffect(() => {
    if (dragging) return
    const pending = pendingRef.current
    if (pending !== null && Math.abs(pending - data.splitRatio) < 1e-6) {
      pendingRef.current = null
      return
    }
    if (pending !== null) return
    setRatio(data.splitRatio)
  }, [data.splitRatio, dragging])

  const clamp = (v: number) => Math.min(0.95, Math.max(0.05, v))

  const onHandleDown = useCallback(
    (e: ReactPointerEvent<HTMLDivElement>) => {
      e.stopPropagation()
      const host = e.currentTarget.parentElement
      if (!host) return
      const rect = host.getBoundingClientRect()
      if (rect.width <= 0) return
      setDragging(true)

      const handleAt = (clientX: number) => clamp((clientX - rect.left) / rect.width)

      const move = (ev: PointerEvent) => {
        setRatio(handleAt(ev.clientX))
      }
      const up = (ev: PointerEvent) => {
        const next = handleAt(ev.clientX)
        setDragging(false)
        setRatio(next)
        pendingRef.current = next
        props.emit({ type: 'updateData', patch: { splitRatio: next } })
        window.removeEventListener('pointermove', move)
        window.removeEventListener('pointerup', up)
      }
      window.addEventListener('pointermove', move)
      window.addEventListener('pointerup', up)
    },
    [props],
  )

  const bothReady = Boolean(leftUrl && rightUrl)

  /**
   * 濯掍綋**鐪熷疄鍍忕礌鍒版墜涔嬪悗**鎶婅妭鐐规绾犳鎴愮礌鏉愭瘮渚嬶紙鍚?`GenerationNodeView.reportNatural`锛夈€?   *
   * 鐢ㄦ埛 2026-10-16锛氥€屽姣旇妭鐐圭殑姣斾緥闇€瑕佽嚜閫傚簲锛屼笉瑕佸浐瀹氥€嶃€傚姣旇妭鐐瑰師鍏堟槸涓?   * `lockAspect` 鐨勫浐瀹?4:3 妗嗭紙240脳180锛夛紝鑰岀礌鏉愬父甯告槸 3072脳5504 閭ｇ绔栭暱鏉?鈥斺€?   * 绔栧浘钀借繘鏂规閲屼袱渚у叏鏄┖鐨勶紙鎴浘灏辨槸杩欐牱锛夈€?   *
   * 涓轰粈涔堝湪**鏄剧ず杩欎竴灞?*琛ワ細鍥剧墖鐨勭湡瀹炲儚绱犲彧鏈夎В鐮佸悗鎵嶇煡閬擄紝杩欓噷姝ｆ槸閭ｄ釜鏃跺埢锛?   * 鍐崇瓥浜ょ粰绾嚱鏁?`assetBoxCorrection`锛堝畠宸茬粡澶勭悊杩囥€岀敤鎴锋墜鍔ㄨ皟杩囧氨涓嶇銆嶈繖涓€妗ｏ級銆?   */
  const reportNatural = (width: number, height: number) => {
    if (!width || !height) return
    const fix = assetBoxCorrection({ w: props.node.w, h: props.node.h }, { width, height })
    if (!fix) return
    props.emit({
      type: 'updateData',
      patch: { naturalSize: fix.naturalSize },
      ...(fix.size ? { size: fix.size } : {}),
      /** 鍚庡彴绾犻敊涓嶆槸鐢ㄦ埛鎿嶄綔锛氫笉杩涙挙閿€鏍堬紝浣嗕粛鐓у父钀藉簱 */
      transient: true,
    })
  }

  /**
   * 鍙屽嚮杩涚伅绠卞姣旓紙鐢ㄦ埛 2026-10-16锛氥€屽弻鍑昏兘鐏杩涜瀵规瘮銆嶏級銆?   *
   * 鐏鏈潵灏辨湁涓€妗ｃ€屽姣斻€嶏紙铻嶅悎缁撴灉璺熷師鍥惧鐫€鐪嬶紝瑙?`LightboxLayer`锛夛紝
   * 杩欓噷鎶?**A 褰撶粨鏋溿€丅 褰撱€屽姣斿師鍥俱€?* 鍠傜粰瀹?鈥斺€?瀵规瘮鑺傜偣鐨勪袱寮犲浘鏉ヨ嚜涓や釜涓嶅悓鐨?   * 涓婃父鑺傜偣锛岃妭鐐逛笂娌℃湁 `compareWith` 鍙锛屾墍浠ュ繀椤绘樉寮忎紶銆?   */
  const openLightbox = () => {
    if (leftFallback) {
      props.emit({
        type: 'openLightbox',
        assetHash: leftFallback,
        ...(rightFallback
          ? {
              compareWith: rightFallback,
              compareKind: 'pair' as const,
            }
          : {}),
      })
      return
    }
    if (rightFallback) props.emit({ type: 'openLightbox', assetHash: rightFallback })
  }

  return (
    <div
      className={styles.body}
      data-compare-ratio={ratio.toFixed(3)}
      title="瀵规瘮椤哄簭锛氬厛杩炴帴鐨勫浘鍦ㄥ乏 A锛屽悗杩炴帴鐨勫浘鍦ㄥ彸 B锛涙嫋鍔ㄤ腑闂寸珫绾挎煡鐪嬪皬宸紓"
      onDoubleClick={openLightbox}
    >
      <div className={styles.stage}>
        <div className={styles.base}>
          {leftUrl ? (
            <img
              src={leftUrl}
              alt=""
              draggable={false}
              onLoad={(e) => reportNatural(e.currentTarget.naturalWidth, e.currentTarget.naturalHeight)}
            />
          ) : (
            <div style={{width:"100%",height:"100%"}} />
          )}
        </div>

        {rightUrl && (
          <div
            className={styles.overlay}
            style={{ clipPath: `inset(0 0 0 ${(ratio * 100).toFixed(3)}%)` }}
          >
            {rightUrl ? <img src={rightUrl} alt="" draggable={false} /> : null}
          </div>
        )}

        {bothReady && (
          <>
            <div
              className={styles.divider}
              style={{ left: `${(ratio * 100).toFixed(3)}%` }}
              aria-hidden="true"
            />
            <div
              /**
               * 鈿狅笍 **`nodrag` 涓嶈兘灏?*锛堢敤鎴?2026-10-16锛氥€屾嫋鍔ㄦ粦鍧楁病鏈夎窡闅忛紶鏍囥€嶏級銆?               *
               * React Flow 鐨勬嫋鍔ㄧ洃鍚寕鍦ㄨ妭鐐瑰厓绱犱笂銆佹槸**鍘熺敓**鐨勶紝鑰?React 鐨?               * `stopPropagation()` 鍙湪鏍瑰鍣ㄩ偅涓€娆″悎鎴愭淳鍙戦噷鐢熸晥 鈥斺€?鍘熺敓鐩戝惉鏃╁氨璺戣繃浜嗐€?               * 浜庢槸鎷栨墜鏌勪細**鍚屾椂鎶婃暣涓妭鐐规嫋璧?*锛氬垎鍓茬嚎鐩稿鑺傜偣娌″姩锛岀湅璧锋潵灏辨槸銆屼笉璺熸墜銆嶃€?               * `nodrag` 鏄?React Flow 鐨勫厤鎷栧姩绫诲悕锛坄NodeFrame` 鐨勭缉鏀炬墜鏌勭敤鐨勫悓涓€鏉″姙娉曪級銆?               */
              className={`${styles.handle} nodrag`}
              data-compare-handle
              style={{ left: `${(ratio * 100).toFixed(3)}%` }}
              onPointerDown={onHandleDown}
              title="鎷栧姩瀵规瘮"
              role="separator"
              aria-label="瀵规瘮鍒嗗壊绾?
            />
          </>
        )}
      </div>
</div>
  )
}

